{
  "$id": "https://open-metadata.org/schema/api/data/asset/createAssetAttribute.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateAssetAttributeRequest",
  "description": "Create AssetAttribute entity request",
  "type": "object",
  "javaType": "org.openmetadata.schema.api.data.asset.CreateAssetAttribute",
  "javaInterfaces": ["org.openmetadata.schema.CreateEntity"],
  "properties": {
    "name": {
      "description": "Name that identifies this asset attribute.",
      "$ref": "../../../type/basic.json#/definitions/entityName"
    },
    "displayName": {
      "description": "Display Name that identifies this asset attribute.",
      "type": "string"
    },
    "description": {
      "description": "Description of the asset attribute.",
      "$ref": "../../../type/basic.json#/definitions/markdown"
    },
    "attributeCategory": {
      "description": "Category of the attribute for grouping.",
      "type": "string",
      "enum": ["basic", "technical", "business", "quality", "security"],
      "default": "basic"
    },
    "dataType": {
      "description": "Data type of the attribute value.",
      "type": "string",
      "enum": ["string", "number", "date", "boolean", "text", "array"],
      "default": "string"
    },
    "required": {
      "description": "Whether this attribute is required when creating a DataAsset.",
      "type": "boolean",
      "default": false
    },
    "assignableRoles": {
      "description": "List of roles that are allowed to fill/edit this attribute.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "owners": {
      "description": "Owners of this asset attribute.",
      "$ref": "../../../type/entityReferenceList.json",
      "default": null
    },
    "reviewers": {
      "description": "User references of the reviewers for this asset attribute.",
      "$ref": "../../../type/entityReferenceList.json"
    },
    "tags": {
      "description": "Tags for this asset attribute.",
      "type": "array",
      "items": {
        "$ref": "../../../type/tagLabel.json"
      },
      "default": null
    },
    "domain": {
      "description": "Fully qualified name of the domain the AssetAttribute belongs to.",
      "type": "string"
    },
    "extension": {
      "description": "Entity extension data with custom attributes added to the entity.",
      "$ref": "../../../type/basic.json#/definitions/entityExtension"
    }
  },
  "required": ["name", "description"],
  "additionalProperties": false
}
