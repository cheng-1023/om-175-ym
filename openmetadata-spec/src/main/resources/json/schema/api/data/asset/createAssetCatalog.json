{
  "$id": "https://open-metadata.org/schema/api/data/asset/createAssetCatalog.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateAssetCatalogRequest",
  "description": "Create AssetCatalog entity request",
  "type": "object",
  "javaType": "org.openmetadata.schema.api.data.asset.CreateAssetCatalog",
  "javaInterfaces": ["org.openmetadata.schema.CreateEntity"],
  "properties": {
    "name": {
      "description": "Name that identifies this asset catalog.",
      "$ref": "../../../type/basic.json#/definitions/entityName"
    },
    "displayName": {
      "description": "Display Name that identifies this asset catalog.",
      "type": "string"
    },
    "description": {
      "description": "Description of the asset catalog.",
      "$ref": "../../../type/basic.json#/definitions/markdown"
    },
    "category": {
      "description": "Fully qualified name of the AssetCategory this catalog belongs to.",
      "type": "string"
    },
    "parent": {
      "description": "Fully qualified name of the parent AssetCatalog. Null for root level catalogs.",
      "type": "string"
    },
    "order": {
      "description": "Display order among siblings at the same level.",
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "owners": {
      "description": "Owners of this asset catalog.",
      "$ref": "../../../type/entityReferenceList.json",
      "default": null
    },
    "reviewers": {
      "description": "User references of the reviewers for this asset catalog.",
      "$ref": "../../../type/entityReferenceList.json"
    },
    "tags": {
      "description": "Tags for this asset catalog.",
      "type": "array",
      "items": {
        "$ref": "../../../type/tagLabel.json"
      },
      "default": null
    },
    "domain": {
      "description": "Fully qualified name of the domain the AssetCatalog belongs to.",
      "type": "string"
    },
    "extension": {
      "description": "Entity extension data with custom attributes added to the entity.",
      "$ref": "../../../type/basic.json#/definitions/entityExtension"
    }
  },
  "required": ["name", "description", "category"],
  "additionalProperties": false
}
